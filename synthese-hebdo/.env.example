# Copiez ce fichier en .env pour un test local, puis : node --env-file=.env --import tsx src/run.ts
# Ne committez jamais le fichier .env.

# --- Secrets ---
ANTHROPIC_API_KEY=A_COMPLETER
AZURE_TENANT_ID=A_COMPLETER
AZURE_CLIENT_ID=A_COMPLETER
AZURE_CLIENT_SECRET=A_COMPLETER

# --- Agent (IDs écrits par `ant apply` dans claude-lock.json) ---
AGENT_ID=A_COMPLETER
ENVIRONMENT_ID=A_COMPLETER

# --- Boîte mail et filtres ---
BOITE_MAIL=A_COMPLETER_prenom.nom@entreprise.fr
FILTRE_EXPEDITEURS=A_COMPLETER_expediteur@entreprise.fr
FILTRE_OBJET=A_COMPLETER_mot_dans_objet
JOURS_EN_ARRIERE=7

# --- Livraison ---
DOSSIER_ONEDRIVE=A_COMPLETER_Rapports/Synthese hebdo
DESTINATAIRES=A_COMPLETER_prenom.nom@entreprise.fr
MODE_LIVRAISON=brouillon
BUDGET_CENTIMES=200
